{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WinTest Config Schema",
  "type": "object",
  "properties": {
    "defaultTimeoutMs": {
      "type": "integer",
      "default": 10000,
      "minimum": 1000
    },
    "retryIntervalMs": {
      "type": "integer",
      "default": 500,
      "minimum": 50
    },
    "evidenceDir": {
      "type": "string",
      "default": "./evidence"
    },
    "videoEnabled": {
      "type": "boolean",
      "default": false
    },
    "reportLanguage": {
      "type": "string",
      "default": "pt-BR"
    },
    "autoClose": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false
}